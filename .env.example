# Copy this file to ".env" and fill in your own keys. Never share your real .env or commit it.

# AssemblyAI: sign up at assemblyai.com, copy the key from your dashboard
ASSEMBLYAI_API_KEY=your_assemblyai_key_here

# Gemini: go to aistudio.google.com, sign in with Google, click "Get API key"
GEMINI_API_KEY=your_gemini_key_here

# Optional: which Gemini models to try, in order (comma-separated, no spaces).
# Check your own free daily limits at https://aistudio.google.com/rate-limit
# If you leave this out, the code uses a sensible default list.
GEMINI_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite

# Admin dashboard login — set your own, don't leave these as the defaults.
ADMIN_USER=your_own_username
ADMIN_PASS=your_own_password

# Optional latency settings (all have safe defaults; see README "Environment variables").
# TIMING_LOGS=1
# GEMINI_TIMEOUT_S=8
# MODEL_COOLDOWN_S=60
# REPLY_TEMPLATES=1
# PARALLEL_CONTINUATION=1
# TTS_CACHE_SIZE=128
# STREAM_AUDIO=1
# TTS_RATE=-10%
# STT_KEYTERMS=0
# STT_MIN_TURN_SILENCE_MS=
# STT_MAX_TURN_SILENCE_MS=
